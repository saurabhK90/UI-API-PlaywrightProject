# ============================================================
# Copy this file to .env and fill in values for your environment
# NEVER commit .env to version control
# ============================================================

# Application URLs
BASE_URL=https://your-app.example.com
API_BASE_URL=https://api.your-app.example.com

# Test Credentials (standard user)
TEST_USERNAME=standard-user@testenv.com
TEST_PASSWORD=your-test-password

# Admin credentials (for setup/teardown via API)
ADMIN_USERNAME=admin@testenv.com
ADMIN_PASSWORD=admin-test-password

# API Authentication
API_KEY=your-api-key-here

# Anthropic AI features (optional — framework works without this)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub (for /submit-pr skill and GitHub MCP)
GITHUB_TOKEN=your-github-token-here

# Jira (for /generate-tests skill with Jira MCP)
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your-email@yourorg.com
JIRA_API_TOKEN=your-jira-api-token

# Logging
LOG_LEVEL=info

# Storage state path (auto-created by globalSetup)
AUTH_STATE_DIR=auth-state
